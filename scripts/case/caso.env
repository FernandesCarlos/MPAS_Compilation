# Edite aqui os parâmetros comuns. Variáveis exportadas no terminal têm prioridade.
RUN_DIR=${RUN_DIR:-/mpas/run}
ERA5_DIR=${ERA5_DIR:-/dados/era5}
WPS_DIR=${WPS_DIR:-/build/WPS}
MESH=${MESH:-x1.10242}
START_TIME=${START_TIME:-2025-01-01_00:00:00}
RUN_DURATION=${RUN_DURATION:-0_01:00:00}
NP=${NP:-4}
JOBS=${JOBS:-2}
DT=${DT:-1200.0}
NVERTLEVELS=${NVERTLEVELS:-55}
OUTPUT_INTERVAL=${OUTPUT_INTERVAL:-00:30:00}
# Informe a Vtable compatível com seus GRIB (caminho absoluto).
# Para ERA5 em níveis de pressão GRIB1, verifique Vtable.ERA-interim.pl.
WPS_VTABLE=${WPS_VTABLE:-}
